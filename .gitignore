# ============================================================
# Kids Colouring Book E-commerce Platform
# Root .gitignore
# ============================================================

# ---- Environment Files (NEVER commit) ----
.env
.env.local
.env.*.local
*.env

# ---- Backend (Java/Maven) ----
backend/target/
backend/.mvn/repository/
backend/*.log
backend/logs/
*.class
*.war
*.ear
*.nar
hs_err_pid*
replay_pid*

# ---- Frontend (Node/React) ----
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
frontend/coverage/
frontend/*.local

# ---- IDE ----
.idea/
*.iml
.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.project
.classpath
.settings/
.factorypath

# ---- OS ----
.DS_Store
.DS_Store?
._*
.Spotlight-V7
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ---- Logs ----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---- Docker ----
.docker/

# ---- Testing ----
backend/src/test/resources/application-test.yml

# ---- Build Outputs ----
build/
out/

# Frontend build baked in by Docker (not source)
backend/src/main/resources/static/
