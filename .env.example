# ============================================================
# Kids Colouring Book E-commerce Platform
# Root Environment Variables Template
# Copy to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# ---- Database ----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=kids_colour_db
DB_USERNAME=kidscolour_user
DB_PASSWORD=kidscolour_pass

# ---- JWT ----
# Generate with: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-minimum-256-bits-change-me-now
JWT_EXPIRATION=900000          # 15 minutes in ms
JWT_REFRESH_EXPIRATION=604800000  # 7 days in ms

# ---- Email (Gmail SMTP) ----
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password   # Create at myaccount.google.com/apppasswords

# ---- AWS S3 (Secure PDF Storage) ----
AWS_ACCESS_KEY=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_REGION=ap-south-1
AWS_S3_BUCKET=kidscolour-pdfs

# ---- Cloudinary (Book Cover Images) ----
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ---- Razorpay (Primary Payment Gateway) ----
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# ---- Stripe (Alternate Payment Gateway) ----
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Meta WhatsApp Cloud API ----
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-permanent-access-token
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ---- Frontend URL (for CORS and email links) ----
FRONTEND_URL=http://localhost:5173

# ---- Application ----
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
